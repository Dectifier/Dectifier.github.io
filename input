    <title>NovaFin | Visual Strategy Deck 2026</title>
    <style>
        /* --- CSS VARIABLES & RESET --- */
        :root {
            --bg-dark: #0a192f;
            --bg-card: #112240;
            --primary: #64ffda; /* Electric Cyan */
            --primary-dim: rgba(100, 255, 218, 0.1);
            --text-main: #ccd6f6;
            --text-muted: #8892b0;
            --accent-blue: #0077b6;
            --accent-purple: #9d4edd;
            --accent-red: #e63946;
            --accent-orange: #f4a261;
            --accent-green: #2a9d8f;
            --font-main: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            --max-width: 1200px;
            --nav-width: 260px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body {
            font-family: var(--font-main);
            background-color: var(--bg-dark);
            color: var(--text-main);
            line-height: 1.5;
            overflow-x: hidden;
        }

        /* --- LAYOUT --- */
        .app-container { display: flex; min-height: 100vh; }

        /* --- SIDEBAR --- */
        .sidebar {
            width: var(--nav-width);
            background: #020c1b;
            position: fixed;
            height: 100vh;
            padding: 2rem 1.5rem;
            display: flex;
            flex-direction: column;
            border-right: 1px solid rgba(255,255,255,0.05);
            z-index: 100;
        }
        .logo { font-size: 1.5rem; font-weight: 700; color: var(--primary); margin-bottom: 2rem; display: flex; align-items: center; gap: 10px; }
        .nav-links { list-style: none; display: flex; flex-direction: column; gap: 0.3rem; }
        .nav-links a {
            text-decoration: none; color: var(--text-muted); font-size: 0.8rem;
            padding: 0.5rem 0.8rem; border-radius: 4px; transition: all 0.2s; display: block;
        }
        .nav-links a:hover, .nav-links a.active { color: var(--primary); background: var(--primary-dim); }
        .deck-footer { margin-top: auto; font-size: 0.7rem; color: var(--text-muted); border-top: 1px solid rgba(255,255,255,0.05); padding-top: 1rem; }

        /* --- MAIN CONTENT --- */
        .main-content { margin-left: var(--nav-width); flex: 1; width: calc(100% - var(--nav-width)); }

        /* --- SLIDES --- */
        section.slide {
            min-height: 100vh;
            padding: 4rem 2rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }
        .slide-container { max-width: var(--max-width); margin: 0 auto; width: 100%; }

        /* --- TYPOGRAPHY --- */
        h1 { font-size: 3.5rem; line-height: 1.1; margin-bottom: 1rem; color: #fff; }
        h2 { font-size: 2rem; margin-bottom: 2rem; color: #fff; display: flex; align-items: center; gap: 1rem; }
        h2::before { content: ''; display: block; width: 4px; height: 2rem; background: var(--primary); }
        h3 { font-size: 1.1rem; color: #fff; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 1px; }
        p { margin-bottom: 1rem; color: var(--text-muted); }
        strong { color: #fff; }

        /* --- GRID SYSTEMS --- */
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
        .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }

        /* --- CARDS --- */
        .card {
            background: var(--bg-card);
            padding: 1.5rem;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px -15px rgba(2,12,27,0.7); border-color: var(--primary-dim); }

        /* --- ICONS --- */
        .icon-box {
            width: 40px; height: 40px; border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 1rem; font-size: 1.2rem;
        }
        .icon-cyan { background: rgba(100,255,218,0.1); color: var(--primary); }
        .icon-blue { background: rgba(0,119,182,0.1); color: var(--accent-blue); }
        .icon-purple { background: rgba(157,78,221,0.1); color: var(--accent-purple); }
        .icon-red { background: rgba(230,57,70,0.1); color: var(--accent-red); }

        /* --- VISUALIZATION: 2x2 MATRIX --- */
        .matrix-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: auto auto;
            gap: 10px;
            position: relative;
            background: var(--bg-card);
            padding: 20px;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.1);
        }
        .matrix-quad {
            height: 150px;
            border-radius: 8px;
            padding: 1rem;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            position: relative;
        }
        .quad-tl { background: rgba(255,255,255,0.03); } /* Low Exp, Low Util */
        .quad-tr { background: rgba(100,255,218,0.05); border: 1px dashed var(--primary); } /* High Exp, Low Util - Niche */
        .quad-bl { background: rgba(0,119,182,0.05); border: 1px dashed var(--accent-blue); } /* Low Exp, High Util - Enterprise */
        .quad-br { 
            background: linear-gradient(135deg, rgba(100,255,218,0.2) 0%, rgba(10,25,47,0) 100%); 
            border: 2px solid var(--primary);
            display: flex; align-items: center; justify-content: center;
        } /* High Exp, High Util - NovaFin */
        
        .matrix-label {
            position: absolute; font-size: 0.75rem; color: var(--text-muted); font-weight: bold;
            text-transform: uppercase;
        }
        .label-top { top: -25px; left: 50%; transform: translateX(-50%); width: 100%; text-align: center; }
        .label-left { left: -80px; top: 50%; transform: translateY(-50%) rotate(-90deg); width: 100%; text-align: center; }
        .label-center { top: 50%; left: 50%; transform: translate(-50%, -50%); color: var(--primary); font-weight: bold; font-size: 1.2rem; text-align: center; border: 2px solid var(--primary); padding: 0.5rem 1rem; background: var(--bg-dark); }

        /* --- VISUALIZATION: FLOW DIAGRAM --- */
        .flow-diagram {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 2rem;
            position: relative;
        }
        .flow-step {
            text-align: center; z-index: 2;
            background: var(--bg-dark);
            padding: 0 10px;
        }
        .flow-circle {
            width: 60px; height: 60px;
            border-radius: 50%;
            background: var(--bg-card);
            border: 2px solid var(--text-muted);
            margin: 0 auto 10px;
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-weight: bold;
        }
        .flow-line {
            position: absolute; top: 30px; left: 0; right: 0; height: 2px;
            background: var(--text-muted); z-index: 1; opacity: 0.3;
        }

        /* --- VISUALIZATION: BAR CHARTS --- */
        .chart-row {
            display: flex; align-items: center; margin-bottom: 1.5rem;
        }
        .chart-label { width: 120px; font-size: 0.9rem; color: var(--text-muted); }
        .chart-bar-bg { flex: 1; height: 12px; background: rgba(255,255,255,0.05); border-radius: 6px; overflow: hidden; }
        .chart-bar-fill { height: 100%; border-radius: 6px; width: 0; transition: width 1.5s ease-out; }
        .chart-value { width: 80px; text-align: right; font-weight: bold; font-size: 0.9rem; }

        /* --- VISUALIZATION: GAUGE / RADIAL --- */
        .gauge-container { display: flex; flex-direction: column; align-items: center; }
        .gauge {
            width: 120px; height: 120px;
            border-radius: 50%;
            background: conic-gradient(var(--accent-red) 0deg 60deg, var(--accent-orange) 60deg 120deg, var(--primary) 120deg 180deg, rgba(255,255,255,0.05) 180deg 360deg);
            position: relative;
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 1rem;
        }
        .gauge::after {
            content: ''; position: absolute; width: 90px; height: 90px;
            background: var(--bg-card); border-radius: 50%;
        }
        .gauge-value { position: absolute; z-index: 2; font-size: 1.5rem; font-weight: bold; color: #fff; }

        /* --- VISUALIZATION: TIMELINE / CYCLE --- */
        .cycle-container { position: relative; width: 300px; height: 300px; margin: 0 auto; }
        .cycle-step {
            position: absolute; width: 80px; height: 80px;
            background: var(--bg-card); border: 2px solid var(--primary);
            border-radius: 50%; display: flex; flex-direction: column;
            align-items: center; justify-content: center; text-align: center;
            font-size: 0.75rem; color: #fff;
        }
        .cs-1 { top: 0; left: 50%; transform: translateX(-50%); }
        .cs-2 { top: 50%; right: 0; transform: translateY(-50%); }
        .cs-3 { bottom: 0; left: 50%; transform: translateX(-50%); }
        .cs-4 { top: 50%; left: 0; transform: translateY(-50%); }

        /* --- UTILS --- */
        .check-list { list-style: none; }
        .check-list li { margin-bottom: 0.8rem; padding-left: 1.5rem; position: relative; }
        .check-list li::before { content: '✔'; position: absolute; left: 0; color: var(--primary); }
        
        .fade-in { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease-out, transform 0.6s ease-out; }
        .fade-in.visible { opacity: 1; transform: translateY(0); }

        /* --- RESPONSIVE --- */
        @media (max-width: 900px) {
            .app-container { flex-direction: column; }
            .sidebar { width: 100%; height: auto; position: relative; padding: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
            .nav-links { flex-direction: row; overflow-x: auto; padding-bottom: 5px; }
            .main-content { margin-left: 0; width: 100%; }
            section.slide { padding: 3rem 1.5rem; min-height: auto; }
            .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
            h1 { font-size: 2.5rem; }
            .flow-diagram { flex-direction: column; gap: 1rem; }
            .flow-line { width: 2px; height: 100%; left: 50%; top: 0; }
            .label-left { display: none; }
        }
    </style>
</head>
